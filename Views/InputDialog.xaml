<Window x:Class="Pc_clicker.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="14,12,14,12">
        <TextBlock x:Name="txtPrompt"
                   Text="请输入名称"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="txtInput"
                 Width="260"
                 Padding="2"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="btnOk"
                    Content="确定"
                    Width="72"
                    IsDefault="True"
                    Click="btnOk_Click"/>
            <Button x:Name="btnCancel"
                    Content="取消"
                    Width="72"
                    Margin="8,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
