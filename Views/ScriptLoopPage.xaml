<UserControl x:Class="Pc_clicker.Views.ScriptLoopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="439" d:DesignWidth="400">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="intro"
                   Text="根据预设脚本进行点击和按键操作，鼠标干扰大，请使用快捷键停止后再进行操作"
                   TextWrapping="Wrap"
                   TextAlignment="Left"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left"
                       Text="目标程序"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <ComboBox x:Name="comboTarget"
                      DropDownOpened="ComboTarget_DropDownOpened"
                      SelectionChanged="ComboTarget_SelectionChanged"
                      ToolTip="目标名称使用进程文件名，窗口标题在悬停提示中显示">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" ToolTip="{Binding Detail}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock Grid.Row="2"
                   x:Name="targetHint"
                   Text=""
                   TextWrapping="Wrap"
                   FontSize="10"
                   Margin="0,0,0,4"/>

        <DockPanel Grid.Row="3" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left"
                       Text="选择配置"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btnAddScript"
                        Content="+"
                        Width="24"
                        Margin="2,0"
                        ToolTip="新建脚本"
                        Click="btnAddScript_Click"/>
                <Button x:Name="btnDeleteScript"
                        Content="-"
                        Width="24"
                        Margin="2,0"
                        ToolTip="删除脚本"
                        Click="btnDeleteScript_Click"/>
            </StackPanel>
            <ComboBox x:Name="comboScript"
                      DropDownOpened="ComboScript_DropDownOpened"
                      SelectionChanged="ComboScript_SelectionChanged"/>
        </DockPanel>

        <ListView Grid.Row="4"
                  x:Name="listScript"
                  Margin="0,0,0,4"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnEditScript"
                    Content="编辑配置"
                    Padding="8,2" Click="btnEditScript_Click"/>
            <Button x:Name="btnOpenFolder"
                    Content="打开配置文件夹"
                    Padding="8,2"
                    Margin="8,0,0,0"
                    Click="btnOpenFolder_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
