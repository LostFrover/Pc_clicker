<UserControl x:Class="Pc_clicker.Views.SinglePointPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="316">
    <StackPanel Orientation="Vertical" Margin="4" HorizontalAlignment="Center">
        <TextBlock x:Name="intro"
                   Text="在鼠标位置持续点击左/右键"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>
        <GroupBox Header="鼠标按键" Padding="6">
            <Grid Width="280" Height="220" HorizontalAlignment="Center">
                <!-- 鼠标主体（俯视，黑白简笔画），整体右移为侧键留出空间 -->
                <!-- 主体：左右对称、上窄下宽的圆角外形 -->
                <Path Data="M 80,40
                            C 80,18 98,8 140,8
                            C 182,8 200,18 200,40
                            L 200,150
                            C 200,182 178,200 140,200
                            C 102,200 80,182 80,150 Z"
                      Fill="White" Stroke="Black" StrokeThickness="2"/>
                <!-- 左右键与掌托的分隔横线 -->
                <Line X1="80" Y1="78" X2="200" Y2="78" Stroke="Black" StrokeThickness="1.5"/>
                <!-- 左右键中间竖直分割线（仅上半部分） -->
                <Line X1="140" Y1="8" X2="140" Y2="78" Stroke="Black" StrokeThickness="1.5"/>
                <!-- 滚轮（居中于分割线顶部） -->
                <Rectangle Width="16" Height="34" RadiusX="8" RadiusY="8"
                           Fill="White" Stroke="Black" StrokeThickness="1.5"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="132,22,0,0"/>
                <Line X1="132" Y1="34" X2="148" Y2="34" Stroke="Black" StrokeThickness="1"/>
                <Line X1="132" Y1="44" X2="148" Y2="44" Stroke="Black" StrokeThickness="1"/>
                <!-- 侧键（内嵌于左侧轮廓） -->
                <Path Data="M 80,96 L 96,92 L 96,110 L 80,114 Z"
                      Fill="White" Stroke="Black" StrokeThickness="1.5"/>
                <Path Data="M 80,120 L 96,116 L 96,134 L 80,138 Z"
                      Fill="White" Stroke="Black" StrokeThickness="1.5"/>

                <!-- RadioButton 按真实鼠标位置排布 -->
                <RadioButton x:Name="leftbtn"
                             Content="左键"
                             IsChecked="True"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="86,48,0,0"/>
                <RadioButton x:Name="rightbtn"
                             Content="右键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="158,48,0,0"/>
                <RadioButton x:Name="middlebtn"
                             Content="中键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="130,2,0,0"/>
                <RadioButton x:Name="sidebtn1"
                             Content="前侧键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="4,92,0,0"/>
                <RadioButton x:Name="sidebtn2"
                             Content="后侧键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="4,116,0,0"/>
            </Grid>
        </GroupBox>
    </StackPanel>
</UserControl>
