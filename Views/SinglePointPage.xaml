<UserControl x:Class="Pc_clicker.Views.SinglePointPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="316">
    <StackPanel Orientation="Vertical" Margin="4" HorizontalAlignment="Center">
        <TextBlock x:Name="intro"
                   Text="在鼠标位置持续点击所选按键（F8 开始/停止）"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>
        <GroupBox Header="鼠标按键" Padding="6">
            <Grid Width="280" Height="246" HorizontalAlignment="Center">
                <!-- 鼠标主体（俯视，黑白简笔画），整体右移为侧键留出空间 -->
                <!-- 主体：左右对称、上窄下宽的圆角外形 -->
                <Path Data="M 80,66
                            C 80,44 98,34 140,34
                            C 182,34 200,44 200,66
                            L 200,176
                            C 200,208 178,226 140,226
                            C 102,226 80,208 80,176 Z"
                      Fill="White" Stroke="Black" StrokeThickness="2"/>
                <!-- 左右键与掌托的分隔横线 -->
                <Line X1="80" Y1="104" X2="200" Y2="104" Stroke="Black" StrokeThickness="1.5"/>
                <!-- 左右键中间竖直分割线（仅上半部分） -->
                <Line X1="140" Y1="34" X2="140" Y2="104" Stroke="Black" StrokeThickness="1.5"/>
                <!-- 滚轮（居中于分割线顶部） -->
                <Rectangle Width="16" Height="34" RadiusX="8" RadiusY="8"
                           Fill="White" Stroke="Black" StrokeThickness="1.5"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="132,48,0,0"/>
                <Line X1="132" Y1="60" X2="148" Y2="60" Stroke="Black" StrokeThickness="1"/>
                <Line X1="132" Y1="70" X2="148" Y2="70" Stroke="Black" StrokeThickness="1"/>
                <!-- 侧键（内嵌于左侧轮廓） -->
                <Path Data="M 80,122 L 96,118 L 96,136 L 80,140 Z"
                      Fill="White" Stroke="Black" StrokeThickness="1.5"/>
                <Path Data="M 80,146 L 96,142 L 96,160 L 80,164 Z"
                      Fill="White" Stroke="Black" StrokeThickness="1.5"/>

                <!-- RadioButton 按真实鼠标位置排布 -->
                <RadioButton x:Name="leftbtn"
                             Content="左键"
                             IsChecked="True"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="86,74,0,0"/>
                <RadioButton x:Name="rightbtn"
                             Content="右键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="158,74,0,0"/>
                <RadioButton x:Name="middlebtn"
                             Content="中键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="130,10,0,0"/>
                <RadioButton x:Name="sidebtn1"
                             Content="前侧键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="4,118,0,0"/>
                <RadioButton x:Name="sidebtn2"
                             Content="后侧键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="4,142,0,0"/>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0">
            <TextBlock Text="点击间隔(毫秒):"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <TextBox x:Name="clickInterval"
                     Text="50"
                     Width="72"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     ToolTip="每次点击之间等待的毫秒数"
                     PreviewTextInput="ClickInterval_PreviewTextInput"/>
        </StackPanel>
    </StackPanel>
</UserControl>
