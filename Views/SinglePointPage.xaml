<UserControl x:Class="Pc_clicker.Views.SinglePointPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="316">
    <StackPanel Orientation="Vertical" Margin="4" HorizontalAlignment="Center">
        <TextBlock x:Name="intro"
                   Text="在鼠标位置持续点击左/右键"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>
        <GroupBox Header="鼠标按键" Padding="6">
            <Grid Width="240" Height="210" HorizontalAlignment="Center">
                <!-- 鼠标主体（俯视，黑白简笔画） -->
                <!-- 主体：左右对称、上窄下宽的圆角外形 -->
                <Path Data="M 60,40
                            C 60,18 78,8 120,8
                            C 162,8 180,18 180,40
                            L 180,150
                            C 180,182 158,200 120,200
                            C 82,200 60,182 60,150 Z"
                      Fill="White" Stroke="Black" StrokeThickness="2"/>
                <!-- 左右键与掌托的分隔横线 -->
                <Line X1="60" Y1="78" X2="180" Y2="78" Stroke="Black" StrokeThickness="1.5"/>
                <!-- 左右键中间竖直分割线（仅上半部分） -->
                <Line X1="120" Y1="8" X2="120" Y2="78" Stroke="Black" StrokeThickness="1.5"/>
                <!-- 滚轮（居中于分割线顶部） -->
                <Rectangle Width="16" Height="34" RadiusX="8" RadiusY="8"
                           Fill="White" Stroke="Black" StrokeThickness="1.5"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="112,20,0,0"/>
                <Line X1="112" Y1="32" X2="128" Y2="32" Stroke="Black" StrokeThickness="1"/>
                <Line X1="112" Y1="42" X2="128" Y2="42" Stroke="Black" StrokeThickness="1"/>
                <!-- 侧键（内嵌于左侧轮廓） -->
                <Path Data="M 60,96 L 76,92 L 76,110 L 60,114 Z"
                      Fill="White" Stroke="Black" StrokeThickness="1.5"/>
                <Path Data="M 60,120 L 76,116 L 76,134 L 60,138 Z"
                      Fill="White" Stroke="Black" StrokeThickness="1.5"/>

                <!-- RadioButton 按真实鼠标位置排布 -->
                <RadioButton x:Name="leftbtn"
                             Content="左键"
                             IsChecked="True"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="64,80,0,0"/>
                <RadioButton x:Name="rightbtn"
                             Content="右键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="128,80,0,0"/>
                <RadioButton x:Name="middlebtn"
                             Content="中键"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="106,2,0,0"/>
                <RadioButton x:Name="sidebtn1"
                             Content="前"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="2,96,0,0"/>
                <RadioButton x:Name="sidebtn2"
                             Content="后"
                             GroupName="MouseButton"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="2,120,0,0"/>
            </Grid>
        </GroupBox>
    </StackPanel>
</UserControl>
