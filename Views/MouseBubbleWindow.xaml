<Window x:Class="Pc_clicker.Views.MouseBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标位置"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="126"
        Height="34"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="#E6212226"
            BorderBrush="#80FFFFFF"
            BorderThickness="1"
            CornerRadius="5"
            Padding="6,2">
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="txtPos"
                       Text="0.000,0.000"
                       Foreground="White"
                       FontFamily="Consolas"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="txtTarget"
                       Text=""
                       Foreground="#FF9AA0A6"
                       FontSize="9"
                       Margin="0,1,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
