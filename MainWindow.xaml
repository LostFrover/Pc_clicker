<Window x:Class="Pc_clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pc_clicker"
        xmlns:views="clr-namespace:Pc_clicker.Views"
        mc:Ignorable="d"
        Title="Pc_clicker" Height="485" Width="403"
        Cursor="Hand">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem x:Name="menuPageSingle" Header="单点循环" Click="MenuPageSingle_Click"/>
            <MenuItem x:Name="menuPageMulti" Header="配置循环" Click="MenuPageMulti_Click"/>
            <MenuItem x:Name="menuPageGuide" Header="指导文档" Click="MenuPageGuide_Click"/>
        </Menu>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
            <ContentControl x:Name="pageHost">
                <views:SinglePointPage x:Name="singlePage"/>
            </ContentControl>
        </Border>

        <Grid Grid.Row="2" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="循环类型" Padding="4">
                <StackPanel Orientation="Vertical">
                    <RadioButton x:Name="loop_count"
                                 Content="次数循环"
                                 IsChecked="True"
                                 GroupName="LoopMode"
                                 Checked="LoopMode_Checked"
                                 Margin="2"/>
                    <RadioButton x:Name="loop_time"
                                 Content="时间循环(分钟)"
                                 GroupName="LoopMode"
                                 Checked="LoopMode_Checked"
                                 Margin="2"/>
                    <RadioButton x:Name="loop_continue"
                                 Content="无限循环"
                                 GroupName="LoopMode"
                                 Checked="LoopMode_Checked"
                                 Margin="2"/>
                </StackPanel>
            </GroupBox>
            <TextBox Grid.Column="1"
                     x:Name="loop_num"
                     Text="1"
                     Width="80"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     PreviewTextInput="LoopNum_PreviewTextInput"/>
        </Grid>

        <Grid Grid.Row="3" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Name="locating"
                    Content="鼠标位置"
                    Margin="0,0,2,0"
                    Click="Locating_Click"/>
            <Button Grid.Column="1"
                    x:Name="excuting"
                    Content="执行"
                    Margin="2,0,0,0"
                    Click="Excuting_Click"/>
        </Grid>
    </Grid>
</Window>
